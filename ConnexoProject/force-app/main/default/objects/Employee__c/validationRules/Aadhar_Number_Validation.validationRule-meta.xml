<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Aadhar_Number_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
  ISBLANK(Employee_Aadhar__c),
  LEN(Employee_Aadhar__c) &lt;&gt; 12
)</errorConditionFormula>
    <errorDisplayField>Employee_Aadhar__c</errorDisplayField>
    <errorMessage>Please enter a valid 12-digit Aadhar number. This field is mandatory.</errorMessage>
</ValidationRule>
